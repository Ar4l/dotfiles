[Unit]
Description=Paseo agent orchestrator daemon
After=network-online.target

[Service]
# agents paseo spawns need claude (~/.local/bin) and codex/opencode/gh (linuxbrew)
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/bin:/usr/bin:/bin
# paseo terminals run $SHELL as a non-login shell, which skips the .bashrc zsh handoff
Environment=SHELL=/home/linuxbrew/.linuxbrew/bin/zsh
ExecStart=%h/.nix-profile/bin/paseo-server
Restart=on-failure
RestartSec=5
# an OOM-killed agent subprocess (a pytest worker, say) must not fail the unit:
# the default, stop, restarts the daemon and with it every agent at once
OOMPolicy=continue
# reclaim and throttle agents before the machine runs dry; past MemoryMax the
# kernel kills the largest process in this unit instead of thrashing the box.
# Sized for rem-dev's 32G.
MemoryHigh=24G
MemoryMax=28G

[Install]
WantedBy=default.target
