[Unit]
Description=Ticket runs: check every run and start agents for ready Linear tickets
Documentation=file://%h/dotfiles/paseo-plugins/ticket-runs/README.md

[Service]
Type=oneshot
# the script calls paseo (nix profile), linear, gh and python3 (linuxbrew)
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/dotfiles/paseo-plugins/ticket-runs/run_tickets.py check
TimeoutStartSec=8min
