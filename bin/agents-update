#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""Update claude, codex, central and paseo on this Mac and on rem-dev. Steps, in order:

 1. Print installed versions on both hosts plus the latest release. (--check stops here)
 2. Mac:     brew upgrade --cask claude-code@latest codex; central update --install
    rem-dev: claude update; brew upgrade --cask codex; central update --install
    These leave running agents alone, so no prompt.
 3. Mac paseo: if `brew outdated --cask paseo` -> PROMPT -> brew upgrade --cask paseo
    (restarts the local daemon). The Mac's paseo version is the target for rem-dev.
    Before any paseo PROMPT: 3-5 bullets of what's new for you. Source: GitHub release
    notes of every stable release after the installed and up to the target version
    (betas skipped). `claude -p --model sonnet` keeps only features relevant to a
    headless Linux daemon + Mac client driving Claude/Codex agents in worktrees, and
    drops bug fixes, mobile, Windows and UI polish. Raw notes are printed if that fails.
 4. rem-dev paseo, only if its version != target:
    a. Fork branch Ar4l/paseo patched/v<target>-nix; create on rem-dev if missing:
       clone the tag, cherry-pick getpaseo/paseo#3853 (node-pty fix; upstream since
       v0.15.1 via #5523, so skipped once the tag has it), scripts/update-nix.sh (tags
       have shipped a stale npm-deps hash), push. If that changed nothing (v0.15.3),
       the upstream tag commit is pinned directly.
    b. nix build it to /tmp/paseo-next on rem-dev; smoke on port 6799: daemon
       reachable with that version, web UI served, terminal create + kill.
    c. If upstream released a newer version meanwhile -> PROMPT: continue or stop.
    d. Rewrite paseo_version/paseo_flake in install.sh, commit, push to main;
       rem-dev: git pull dotfiles (unit is a stow symlink), set
       features.webUi.enabled with the new binary, systemctl --user daemon-reload.
    e. PROMPT (shows running agents) -> nix profile remove/add, restart paseo.service.
       Interrupts running turns; idle agents resume. ~15 s down.
    f. Verify: version, terminal create + kill, agent count; print downtime.
       Then comment the validation on PR 3853.
 5. If PR 3853 is merged/closed, print what to delete from this script.

PROMPTs read /dev/tty; without one the script stops there. --approve-paseo answers
yes to all of them and is only for when a human already approved out of band.

Every step is idempotent: after any failure, rerun. Slow rem-dev steps (4a, 4b, 4e-f)
run detached on rem-dev with their log streamed back, so a dropped SSH/IAP connection
only costs a reconnect; gh and ssh calls retry.
"""
import argparse, json, os, re, subprocess, sys, time
from pathlib import Path

REMOTE = "rem-dev"
REMOTE_PATH = "export PATH=$HOME/.local/bin:$HOME/.nix-profile/bin:/home/linuxbrew/.linuxbrew/bin:$PATH;"
DOTFILES = Path(__file__).resolve().parent.parent
UPSTREAM, FORK, FIX_PR = "getpaseo/paseo", "Ar4l/paseo", 3853
UNPATCHED_GLOB = "`node_modules/node-pty/prebuilds/${process.platform}-${process.arch}/**`"
SMOKE_PORT = 6799
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=30", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4", REMOTE]
TOOLS = {  # name: (mac update, rem-dev update)
    "claude": ("brew upgrade --cask claude-code@latest", "claude update"),
    "codex": ("brew upgrade --cask codex", "brew upgrade --cask codex"),
    "central": ("central update --install", "central update --install"),
}
LATEST = {  # name: GitHub repo whose latest release is the reference version; central resolves its own
    "claude": "anthropics/claude-code", "codex": "openai/codex", "paseo": UPSTREAM,
}


COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text
dim, bold, green, yellow, red = (lambda t, c=c: paint(c, t) for c in ("2", "1", "32", "33", "31"))


def log(msg):
    print(dim(time.strftime("%H:%M:%S") + " " + msg), flush=True)


def sh(cmd, host=None, check=True, env="", stdin=None):
    """Run a short command on the Mac or on rem-dev. Remote commands must be idempotent: a lost connection (ssh rc 255) is retried."""
    argv = [*SSH, REMOTE_PATH + cmd] if host else env + cmd
    for attempt in range(3):
        r = subprocess.run(argv, shell=host is None, capture_output=True, text=True, input=stdin)
        if not (host and r.returncode == 255):
            break
        log(yellow(f"ssh to {host} failed ({r.stderr.strip()[-120:] or 'connection lost'}), retry {attempt + 1}/2"))
        time.sleep(5)
    if r.returncode and check:
        sys.exit(red(f"FAILED ({host or 'mac'}, exit {r.returncode}): {cmd}\n{r.stdout}{r.stderr}\nNothing is half-applied; rerun to continue."))
    return r.stdout.strip() if r.returncode == 0 else ""


def remote_job(name, script):
    """Run a slow bash script detached on rem-dev and stream its log; return the log.

    Not tied to the SSH session: IAP dropped the connection 10 minutes into a silent nix build once, which failed the
    run with no output while the build carried on remotely. Here a drop only costs a reconnect. flock serialises
    against a job orphaned by Ctrl-C, so two smoke daemons never share the port.
    """
    base = f"/tmp/agents-update-{name}-{int(time.time())}"
    sh(f"cat > {base}.sh && : > {base}.log && flock -n /tmp/agents-update.lock true || echo 'waiting for a previous agents-update job on {REMOTE}' >> {base}.log; "
       f"nohup setsid bash -c 'flock /tmp/agents-update.lock bash {base}.sh >> {base}.log 2>&1; echo $? > {base}.rc' >/dev/null 2>&1 </dev/null &", REMOTE, stdin=script)
    out, seen, misses, t0, quiet = b"", 0, 0, time.time(), time.time()
    while True:
        time.sleep(3)
        r = subprocess.run([*SSH, f"rc=$(cat {base}.rc 2>/dev/null); tail -c +{seen + 1} {base}.log; printf '\\036%s' \"$rc\""], capture_output=True)
        chunk, sep, rc = r.stdout.rpartition(b"\x1e")
        if r.returncode or not sep:
            misses += 1
            if misses == 1:
                log(yellow(f"lost the connection to {REMOTE}; `{name}` keeps running there, reconnecting"))
            if misses > 60:
                sys.exit(red(f"{REMOTE} unreachable for minutes. `{name}` continues there (log: {base}.log); rerun once `ssh {REMOTE}` works."))
            continue
        misses = 0
        if chunk:
            sys.stdout.write(chunk.decode(errors="replace")), sys.stdout.flush()
            out, seen, quiet = out + chunk, seen + len(chunk), time.time()
        elif time.time() - quiet > 60:
            log(f"{name}: still running on {REMOTE} ({(time.time() - t0) / 60:.0f} min)")
            quiet = time.time()
        if rc:
            break
    if rc != b"0":
        sys.exit(red(f"FAILED ({REMOTE}): {name} exited {rc.decode()}; log kept at {base}.log. Nothing is swapped unless the log above says so; rerun to retry."))
    sh(f"rm -f {base}.sh {base}.log {base}.rc", REMOTE, check=False)
    return out.decode(errors="replace")


def version_in(text):
    m = re.search(r"\d+\.\d+\.\d+", text)
    return m.group() if m else "-"


def version(tool, host=None):
    return version_in(sh(f"{tool} --version 2>&1", host, check=False))


def running_agents(host=None):
    out = sh("paseo ls --json 2>/dev/null", host, check=False)
    return sum(a.get("status") not in ("idle", "closed") for a in json.loads(out or "[]"))


def confirm(question, approve):
    if approve:
        print(f"{question} -> approved via --approve-paseo")
        return True
    try:  # separate handles: "r+" on a tty raises UnsupportedOperation on macOS
        tin, tout = open("/dev/tty"), open("/dev/tty", "w")
    except OSError:
        print(f"{question}\n  No TTY: rerun interactively, or with --approve-paseo once a human has said yes.")
        return False
    tout.write(f"\n{bold(yellow(question))} [y/N] "), tout.flush()
    return tin.readline().strip().lower() == "y"


def gh(args, missing_ok=False):
    """gh on the Mac, retried: api.github.com drops connections now and then. missing_ok: return "" on HTTP 404."""
    for attempt in range(3):
        r = subprocess.run(f"gh {args}", shell=True, capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout.strip()
        if missing_ok and "HTTP 404" in r.stderr:
            return ""
        time.sleep(3 * (attempt + 1))
    sys.exit(red(f"FAILED (mac): gh {args}\n{r.stdout}{r.stderr}\nNothing is half-applied; rerun to continue."))


def latest(tool):
    if tool in LATEST:
        return version_in(gh(f"api repos/{LATEST[tool]}/releases/latest --jq .tag_name"))
    return version_in(sh("central update </dev/null 2>&1 | grep -i 'target version'", check=False))


def report():
    log(f"checking versions on mac, {REMOTE}, and upstream")
    rows = [(t, version(t), version(t, REMOTE), latest(t)) for t in [*TOOLS, "paseo"]]
    print(bold(f"{'tool':8} {'mac':10} {REMOTE:10} latest"))
    for tool, mac, remote, new in rows:
        cell = lambda v: (green if v == new else red if v == "-" else yellow)(f"{v:10}")  # green: current, yellow: behind, red: missing
        print(f"{tool:8} {cell(mac)} {cell(remote)} {new}")
    return dict((r[0], r[1:3]) for r in rows)


def update_tools(before):
    log("brew update")
    sh("brew update")
    for tool, (mac, remote) in TOOLS.items():
        log(f"{tool}: mac `{mac}`, {REMOTE} `{remote}`")
        sh(mac, env="HOMEBREW_NO_AUTO_UPDATE=1 ")
        sh(remote, REMOTE)
        arrow = lambda old, now: f"{old} -> {green(now)}" if old != now else dim(f"{now} unchanged")
        print(f"{tool:8} mac {arrow(before[tool][0], version(tool))}   {REMOTE} {arrow(before[tool][1], version(tool, REMOTE))}")
    if before["claude"][0] != version("claude"):
        print("note: claude changed on the Mac; restart the tmux server from kitty if Downloads/Desktop give EPERM")


def update_paseo_mac(approve):
    log("checking the paseo cask")
    outdated = sh("brew outdated --cask paseo --verbose", env="HOMEBREW_NO_AUTO_UPDATE=1 ")  # "paseo (0.10.2) != 0.10.3"
    if not outdated:
        return
    changelog(version("paseo"), outdated.split()[-1])
    if confirm(f"Upgrade paseo on the Mac? Restarts the local daemon ({running_agents()} agents running).", approve):
        log("brew upgrade --cask paseo")
        sh("brew upgrade --cask paseo", env="HOMEBREW_NO_AUTO_UPDATE=1 ")
        print(f"paseo mac -> {version('paseo')}")


def latest_release():
    log("checking the latest upstream release")
    return gh(f"api repos/{UPSTREAM}/releases/latest --jq .tag_name")  # authenticated: anonymous calls hit the 60/h limit


def changelog(old, new):
    """Print 3-5 user-relevant new features from the stable releases in (old, new]."""
    v = lambda s: tuple(int(x) for x in s.split("."))
    rels = [x for x in json.loads(gh(f"api 'repos/{UPSTREAM}/releases?per_page=100'"))
            if "-" not in x["tag_name"] and v(old) < v(x["tag_name"][1:]) <= v(new)]
    notes = "\n\n".join(x["body"] for x in sorted(rels, key=lambda x: v(x["tag_name"][1:])))
    if not notes:
        return
    log(f"summarising paseo release notes {old} -> {new} with `claude -p --model sonnet`")
    prompt = (f"Paseo release notes {old} -> {new} follow. List the new features that matter to this user: runs the "
              "paseo daemon headless on a Linux VM (Nix, systemd) with the Mac desktop app and CLI as clients; drives Claude "
              "Code and Codex agents in git worktrees; uses terminals, MCP tools, schedules. Skip bug fixes, mobile, Windows, "
              "and UI polish. Output 3 bullets (at most 5), each one line starting with '- ', concrete, no marketing; nothing else.\n\n" + notes)
    out = subprocess.run(["claude", "-p", "--model", "sonnet"], input=prompt, capture_output=True, text=True, env={**os.environ, "CLAUDECODE": ""})
    n = len(rels)
    print(bold(f"\npaseo {old} -> {new}, what's new for you:")
          + dim(f"  ({n} stable release{'s'[:n ^ 1]}, betas skipped; sonnet picked what fits a headless Linux daemon + Mac"
                " client driving Claude/Codex agents, dropping bug fixes, mobile, Windows and UI polish)")
          + f"\n{out.stdout.strip() or notes[:3000]}\n")


def resolve_flake(tag):
    """Return (flake ref, cherry-picked the fix). The tag itself when it builds as-is, else the fork branch."""
    branch = f"patched/{tag}-nix"
    log(f"looking up {FORK} {branch}")
    tag_sha = gh(f"api repos/{UPSTREAM}/commits/{tag} --jq .sha")
    sha = gh(f"api repos/{FORK}/branches/{branch} --jq .commit.sha", missing_ok=True)
    needs_fix = False
    if not sha:
        src = gh(f"api repos/{UPSTREAM}/contents/scripts/trace-daemon.mjs?ref={tag} --jq .content | base64 -d")
        needs_fix = UNPATCHED_GLOB in src
        log(f"creating {branch} on {REMOTE}: clone {tag}, {'cherry-pick #%d, ' % FIX_PR if needs_fix else ''}recompute nix hash (~1 min), push")
        fix = f"git fetch -q https://github.com/{UPSTREAM} pull/{FIX_PR}/head; git cherry-pick $(git merge-base HEAD FETCH_HEAD)..FETCH_HEAD" if needs_fix else ""
        sha = remote_job("branch", f"""set -eo pipefail; d=$(mktemp -d); trap 'rm -rf $d' EXIT
            git clone -q --filter=blob:none --branch {tag} https://github.com/{UPSTREAM} $d; cd $d
            {fix}
            ./scripts/update-nix.sh 2>&1 | tail -3
            git add -A; git diff --cached --quiet || git commit -qm 'fix(nix): correct dependency hash for {tag}'
            git push -q git@github.com:{FORK}.git HEAD:refs/heads/{branch}; git rev-parse HEAD
            """).split()[-1]
    if sha == tag_sha:  # nothing had to be committed on top of the tag
        print(f"upstream {tag} builds as-is; once that holds for a few releases, drop the patched-branch code in this script")
        return f"github:{UPSTREAM}/{sha}", False
    return f"github:{FORK}/{sha}", needs_fix


def build_and_smoke(flake, target):
    """nix build to /tmp/paseo-next on rem-dev and run upstream's smoke on a spare port."""
    log(f"{REMOTE}: nix build {flake} -> /tmp/paseo-next (~15 min when uncached, seconds otherwise), then smoke on :{SMOKE_PORT}")
    out = remote_job("build", f"""set -eo pipefail; nix build {flake} -o /tmp/paseo-next
        P=/tmp/paseo-next/bin/paseo; export PASEO_HOME=$(mktemp -d) PASEO_LISTEN=127.0.0.1:{SMOKE_PORT}
        PASEO_WEB_UI_ENABLED=true /tmp/paseo-next/bin/paseo-server --no-relay >$PASEO_HOME/wrapper.log 2>&1 & pid=$!
        trap 'rc=$?; [ $rc = 0 ] || tail -5 $PASEO_HOME/wrapper.log | cut -c1-300; kill $pid 2>/dev/null; wait $pid 2>/dev/null; rm -rf $PASEO_HOME' EXIT
        for i in $(seq 30); do $P daemon status --json 2>/dev/null | grep '"connectedDaemon": *"reachable"' >/dev/null && break; sleep 1; done
        $P daemon status --json | grep -E '"(daemonVersion|connectedDaemon)"'
        curl -fsS -o /dev/null http://127.0.0.1:{SMOKE_PORT}/; echo 'web UI ok'
        id=$($P terminal create --cwd $PASEO_HOME --json | python3 -c 'import sys,json; print(json.load(sys.stdin)["id"])')
        $P terminal kill $id >/dev/null; echo "terminal ok ($id)"
        """)
    missing = [w for w in (f'"{target}"', '"reachable"', "web UI ok", "terminal ok") if w not in out]
    if missing:
        sys.exit(red(f"smoke test failed: no {', '.join(missing)} in the output above. Nothing is swapped."))


def pin(target, flake):
    """Record the pin in install.sh, push, and stage config + unit on rem-dev (unit is a stow symlink)."""
    log("pinning install.sh and pushing to main")
    f = DOTFILES / "install.sh"
    s = re.sub(r"(# Pinned to )v[\d.]+", rf"\g<1>v{target}", f.read_text())
    s = re.sub(r"paseo_version=.*", f"paseo_version={target}", s)
    s = re.sub(r"paseo_flake=.*", f"paseo_flake={flake}", s)
    f.write_text(s)
    if sh(f"git -C {DOTFILES} status --short install.sh"):
        sh(f"git -C {DOTFILES} commit -qm 'paseo: pin v{target} Nix release' install.sh && git -C {DOTFILES} push -q origin HEAD:main")
        print(f"install.sh pinned to {flake}, pushed to main")
    log(f"{REMOTE}: pull dotfiles, set features.webUi.enabled, systemctl daemon-reload")
    sh(f"""set -e; git -C ~/dotfiles pull -q --ff-only
        /tmp/paseo-next/bin/paseo daemon config set features.webUi.enabled true >/dev/null
        systemctl --user daemon-reload""", REMOTE)


def swap_and_verify(flake, target):
    log(f"{REMOTE}: nix profile remove paseo; nix profile add {flake}; systemctl --user restart paseo.service; verify")
    out = remote_job("swap", f"""set -eo pipefail
        nix profile remove paseo 2>/dev/null || true
        nix profile add {flake}
        systemctl --user restart paseo.service; t0=$(date +%s)
        for i in $(seq 60); do paseo daemon status --json 2>/dev/null | grep '"connectedDaemon": *"reachable"' >/dev/null && break; sleep 1; done
        echo "restart to reachable: $(( $(date +%s) - t0 ))s"
        paseo daemon status --json | grep -E '"(daemonVersion|cliVersion|connectedDaemon)"'
        id=$(paseo terminal create --cwd ~ --json | python3 -c 'import sys,json; print(json.load(sys.stdin)["id"])')
        paseo terminal kill $id >/dev/null; echo "terminal ok"
        echo "agents: $(paseo ls --json | python3 -c 'import sys,json; print(len(json.load(sys.stdin)))')"
        """)
    if f'"{target}"' not in out or '"reachable"' not in out or "terminal ok" not in out:
        sys.exit(red(f"{REMOTE} paseo did not come back healthy; check: ssh {REMOTE} journalctl --user -u paseo.service -n 50"))


def update_paseo_remote(approve):
    target, remote = version("paseo"), version("paseo", REMOTE)
    if remote == target:
        return False
    tag = f"v{target}"
    if remote != "-":
        changelog(remote, target)
    flake, built = resolve_flake(tag)
    build_and_smoke(flake, target)
    latest = latest_release()
    if latest != tag and not confirm(f"{latest} was released; Mac is on {tag}. Continue pinning {REMOTE} to {tag} (n: upgrade the Mac first and rerun)?", approve):
        return built
    pin(target, flake)
    if not confirm(f"Restart paseo on {REMOTE} {remote} -> {target}? Interrupts running turns: {running_agents(REMOTE)} agents running now.", approve):
        return built
    swap_and_verify(flake, target)
    if built:
        log(f"commenting validation on PR {FIX_PR}")
        gh(f"""pr comment {FIX_PR} -R {UPSTREAM} --body "Validated {tag} on Linux x86_64 with this fix cherry-picked onto the tag ({flake}): nix build, daemon reachable, web UI served, terminal create/kill, deployed as the daemon on a dev VM." """)
    return built


def check_fix_pr():
    log(f"checking upstream PR {FIX_PR}")
    pr = json.loads(gh(f"pr view {FIX_PR} -R {UPSTREAM} --json state,mergedAt"))
    if pr["state"] == "MERGED":
        print(f"PR {FIX_PR} merged: drop the cherry-pick in resolve_flake() and the #{FIX_PR} note in install.sh")
    elif pr["state"] == "CLOSED":
        print(f"PR {FIX_PR} closed: the fix is upstream since v0.15.1 (#5523); drop the cherry-pick path in resolve_flake()")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true", help="report versions only")
    ap.add_argument("--approve-paseo", action="store_true", help="skip paseo prompts (human already approved)")
    a = ap.parse_args()
    before = report()
    if a.check:
        sys.exit()
    update_tools(before)
    update_paseo_mac(a.approve_paseo)
    update_paseo_remote(a.approve_paseo)
    check_fix_pr()
    log(green("done"))
